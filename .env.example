# Supabase Connection Configuration (Required for API and Auth)
# Replace with your project-specific credentials from the Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: E2E Playwright Testing Credentials
# Required to run authenticated Playwright tests against an existing verified account
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000

